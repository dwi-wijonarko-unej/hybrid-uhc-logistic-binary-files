# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage

# Virtual environments
.venv/
venv/
env/

# Real-format benchmark: large binaries stay out of git; the 1 MB class and
# all reports/manifests are committed as publication artifacts.
benchmark/source/*
benchmark/encrypted/*
benchmark/decrypted/*
!benchmark/source/*Small*
!benchmark/encrypted/*Small*
!benchmark/decrypted/*Small*

# Local test inputs stay uncommitted (regenerable / private datasets)
data/input/*
!data/input/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
